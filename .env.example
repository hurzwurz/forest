# Port des Servers
PORT=3000

# Schlüssel für die Anmelde-Tokens. Ohne Angabe wird beim ersten Start
# automatisch einer erzeugt und in data/.jwt-secret abgelegt.
# JWT_SECRET=

# Pfad zur Weltdatenbank
# DB_FILE=data/forest.db

# Formt die gesamte Welt: gleicher Seed = gleiche Pflanzplätze.
# Ein anderer Wert erzeugt eine komplett andere Verteilung.
WORLD_SEED=forest-v1
