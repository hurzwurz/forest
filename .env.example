# Verbindung zur Weltdatenbank (PostgreSQL). Pflichtangabe.
# Lokal mit `docker compose up -d db`:
DATABASE_URL=postgres://forest:forest@localhost:5432/forest
# Gehostet, z. B. bei neon.tech:
# DATABASE_URL=postgres://benutzer:passwort@ep-xyz.eu-central-1.aws.neon.tech/forest?sslmode=require

# Port des Servers
PORT=3000

# Schlüssel für die Anmelde-Tokens. Ohne Angabe erzeugt der Server beim ersten
# Start einen und legt ihn in der Datenbank ab.
# JWT_SECRET=

# Formt die gesamte Welt: gleicher Seed = gleiche Pflanzplätze.
WORLD_SEED=forest-v1
